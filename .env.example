# Copy to .env.local (or .env) and fill in. Never commit real values.

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- NextAuth (Auth.js v5) ----------
# Generate with: npx auth secret
AUTH_SECRET=
# Required in production behind a proxy / custom domain
# AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true

# ---------- Google OAuth / SDK ----------
# https://console.cloud.google.com/apis/credentials
# Redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------- Supabase ----------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
